<div class="photos-header">
  <h1> 写真一覧</h1>
  <%= link_to "＋ 写真を投稿", new_photo_path, class: "photo-post-button" %>
</div>

<div class="photo-list">
  <% @photos.each do |photo| %>
    <div class="photo-card">

      <% if photo.image.attached? %>
        <%= link_to photo_path(photo) do %>
          <%= image_tag photo.image, width: 300 %>
        <% end %>
      <% end %>

      <h2>
        <%= photo.title %>
      </h2>
    
      <% if photo.location.present? %>
        <p>📍  <%= photo.location %></p>
      <% end %>

      <div class="photo-user">
        <div class="profile-avatar">
          <% if photo.user.avatar.attached? %>
            <%= image_tag photo.user.avatar %>
          <% else %>
            <%= photo.user.username.first.upcase %>
          <% end %>
        </div>

        <span><%= photo.user.username %></span>
      </div>

      <p class="photo-stats">
        ♡ <%= photo.favorites.count %>
        💬 <%= photo.comments.count %>
      </p>

      <% if photo.techniques.any? %>
        <p>
          撮影技法・構図 : <%= photo.techniques.map(&:name).join("・") %>
        </p>
      <% end %>

      <p><%= photo.description %></p>
    
      <!-- カード全体をクリックするためのリンク -->
      <%= link_to photo_path(photo),
          class: "photo-card-overlay",
          aria: { label: "#{photo.title}の詳細を見る" } do %>
      <% end %>

    </div>
  <% end %>
</div>