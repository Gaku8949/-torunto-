<div class="photo-form-page">

  <%= link_to "← 写真一覧に戻る", photos_path, class: "back-link" %>

  <h1>写真を投稿</h1>

  <%= form_with model: @photo, class: "photo-form" do |f| %>

    <div class="photo-form-layout">

      <!-- 左側 -->
      <div class="photo-form-left">

        <!-- 写真アップロード -->
        <div class="form-section">

          <div class="image-upload-box">
            <div class="image-upload-icon">▧</div>

            <strong>写真を選択</strong>

            <p>
              クリック、またはドラッグ＆ドロップで画像を選択
            </p>

            <span>対応形式：jpg / jpeg / png（最大10MB）</span>

            <%= f.file_field :image, accept: "image/*", class: "image-file-input" %>
          </div>

        </div>


        <!-- タイトル -->
        <div class="form-section">
          <%= f.label :title, "タイトル" %>

          <%= f.text_field :title,
              placeholder: "タイトルを入力してください",
              class: "form-input" %>
        </div>


        <!-- 説明 -->
        <div class="form-section">
          <%= f.label :description, "説明" %>

          <%= f.text_area :description,
              placeholder: "写真についての説明を入力してください",
              class: "form-textarea" %>
        </div>

      </div>


      <!-- 右側 -->
      <div class="photo-form-right">

        <!-- 撮影場所 -->
        <div class="form-card">

          <h2>撮影場所</h2>

          <%= f.text_field :location,
              placeholder: "撮影場所を入力（例：福岡市）",
              class: "form-input" %>

        </div>


        <!-- 撮影設定 -->
        <div class="form-card">

          <h2>撮影設定</h2>

          <%= f.fields_for :shooting_setting do |sf| %>
            <div class="shooting-setting-item">

              <details class="shooting-setting-details">

                <summary class="shooting-setting-header">
                  <%= sf.label :aperture, "F値" %>
                  <%= sf.number_field :aperture, placeholder: "例：5.6" %>
                  <span class="info-icon">ⓘ</span>
                </summary>

                <div class="shooting-setting-description">
                  ➤F値はレンズの絞りの大きさを表す値です。
                  数値が小さいほど背景をぼかしやすくなります。
                </div>

              </details>
            </div>

            <div class="shooting-setting-item">

              <details class="shooting-setting-details">

                <summary class="shooting-setting-header">
                  <%= sf.label :iso, "ISO" %>
                  <%= sf.number_field :iso, placeholder: "例：100" %>
                    <span class="info-icon">ⓘ</span>
                </summary>

                <div class="shooting-setting-description">
                  ➤ISO感度は、カメラが光を受け取る感度を表します。
                  数値を上げると暗い場所でも明るく撮影できますが、ノイズが増えやすくなります。
                </div>

              </details>
            </div>

            <div class="shooting-setting-item">
              
              <details class="shooting-setting-details">

                <summary class="shooting-setting-header">
                  <%= sf.label :shutter_speed, "シャッタースピード" %>
                  <%= sf.text_field :shutter_speed, placeholder: "例：1/250" %>
                    <span class="info-icon">ⓘ</span>
                </summary>

                <div class="shooting-setting-description">
                  ➤シャッターが開いている時間を表します。
                  速くすると動きを止めやすく、遅くすると動きのブレや光の軌跡を表現できます。
                </div> 

              </details>
            </div>

            <div class="shooting-setting-item">

              <details class="shooting-setting-details">

                <summary class="shooting-setting-header">
                  <%= sf.label :focal_length, "焦点距離" %>
                  <%= sf.text_field :focal_length, placeholder: "例：50mm" %>
                    <span class="info-icon">ⓘ</span>
                </summary>
              
                <div class="shooting-setting-description">
                  ➤レンズの焦点距離を表す値です。
                  数値が小さいほど広い範囲を写し、数値が大きいほど遠くの被写体を大きく写せます。
                </div>

              </details>
            </div>

          <% end %>

        </div>


        <!-- 撮影技法・構図 -->
        <div class="form-card">

          <div>
            <h2>
              撮影技法・構図
              <span class="optional">（複数選択可）</span>
            </h2>

            <div class="technique-grid">

              <% @techniques.each do |technique| %>

                <div class="technique-item">

                  <%= check_box_tag "photo[technique_ids][]",
                      technique.id,
                      false,
                      id: "technique_#{technique.id}" %>

                  <details class="technique-details">

                    <summary>
                      <%= technique.name %>
                      <span class="info-icon">ⓘ</span>
                    </summary>

                    <div class="technique-description">
                      <%= technique.description %>
                    </div>

                  </details>
                  
                </div>

              <% end %>

            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ボタン -->
    <div class="form-actions">

      <%= link_to "キャンセル",
          photos_path,
          class: "cancel-button" %>

      <%= f.submit "投稿する",
          class: "submit-button" %>

    </div>

  <% end %>

</div>