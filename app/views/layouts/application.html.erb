<!DOCTYPE html>
<html>
  <head>
    <title>App</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
  </head>

  <body>
  <% unless controller_name == "home" && action_name == "landing" %>
    <header class="site-header">
      <div class="header-logo">
        <%= link_to root_path do %>
          <%= image_tag "TORUNTOimage.png", alt: "TORUNTO" %>
        <% end %>
      </div>

      <nav class="header-nav">
        <%= link_to "ホーム", home_path %>
        <%= link_to "写真一覧", photos_path %>
        <%= link_to "写真を投稿", new_photo_path %>
        <%= link_to "チャレンジ", challenges_path %>
        <%= link_to "プロフィール", profile_path %>
        <%= link_to "使い方", how_to_use_path %>

        <% if user_signed_in? %>
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, data: { turbo_confirm: "ログアウトしますか？" }  %>
        <% end %>
      </nav>
    </header>
    <% end %>

    <main>
      <div class="flash-messages">
        <% if notice %>
          <p class="flash-notice"><%= notice %></p>
        <% end %>

        <% if alert %>
          <p class="flash flash-alert"><%= alert %></p>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="footer-links">
        <%= link_to "利用規約", terms_path %>
        <span class="footer-divider">|</span>
        <%= link_to "プライバシーポリシー", privacy_path %>
      </div>

      <p class="copyright">
        &copy; 2026 TORUNTO
      </p>
    </footer>

  </body>
</html>
