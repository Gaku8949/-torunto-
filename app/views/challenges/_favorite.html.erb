<%= turbo_frame_tag "challenge_favorite_#{challenge.id}" do %>

  <%= button_to challenge_challenge_favorite_path(challenge),
      method: challenge.favorited_by?(current_user) ? :delete : :post,
      class: "challenge-favorite-button #{'liked' if challenge.favorited_by?(current_user)}" do %>

    <% if challenge.favorited_by?(current_user) %>
      ♥ お気に入り解除
    <% else %>
      ♡ お気に入り
    <% end %>

  <% end %>

<% end %>