<%= link_to "← チャレンジ一覧に戻る",
    challenges_path,
    class: "back-link" %>

<div class="challenge-edit-container">

  <h1>撮影チャレンジを編集</h1>

  <%= form_with model: [@photo, @challenge] do |f| %>

    <div class="challenge-edit-grid">

      <!-- =========================
           左側：参考写真・チャレンジ写真・タイトル・コメント
           ========================= -->

      <div class="challenge-edit-left">

        <!-- 参考写真 -->

        <div class="challenge-edit-reference">

          <h2>参考写真</h2>

          <% if @photo.image.attached? %>
            <%= image_tag @photo.image,
                class: "challenge-edit-reference-image" %>
          <% end %>

        </div>


        <!-- チャレンジ写真 -->

        <div class="challenge-edit-card">

          <h2>チャレンジ写真</h2>

          <div class="challenge-image-upload-box">

            <div class="challenge-image-upload-icon">
              ▧
            </div>

            <strong>写真を選択</strong>

            <p>
              クリック、またはドラッグ＆ドロップで画像を選択
            </p>

            <span>対応形式：jpg / jpeg / png（最大10MB）</span>

            <%= f.file_field :image,
                accept: "image/*",
                class: "challenge-image-file-input" %>

          </div>

        </div>


        <!-- タイトル -->

        <div class="challenge-edit-card">

          <div class="challenge-edit-field">

            <%= f.label :title, "タイトル" %>

            <%= f.text_field :title,
                placeholder: "タイトルを入力してください" %>

          </div>

        </div>


        <!-- コメント -->

        <div class="challenge-edit-card">

          <div class="challenge-edit-field challenge-comment-field">

            <%= f.label :comment, "コメント" %>

            <%= f.text_area :comment,
                placeholder: "撮影してみた感想や意識したポイント" %>

          </div>

        </div>

      </div>


      <!-- =========================
           右側：撮影場所・撮影設定・技法
           ========================= -->

      <div class="challenge-edit-right">


        <!-- 撮影場所 -->

        <div class="challenge-edit-card challenge-edit-blue-card">

          <h2>撮影場所</h2>

          <%= f.text_field :location,
              placeholder: "撮影場所を入力（例：福岡市）" %>

        </div>


        <!-- 撮影設定 -->

        <div class="challenge-edit-card challenge-edit-blue-card">

          <h2>撮影設定</h2>

          <%= f.fields_for :shooting_setting do |sf| %>

            <!-- F値 -->

            <div class="challenge-shooting-setting-item">

              <details class="challenge-shooting-setting-details">

                <summary class="challenge-shooting-setting-header">

                  <%= sf.label :aperture, "F値" %>

                  <%= sf.number_field :aperture,
                      placeholder: "例：5.6" %>

                  <span class="challenge-info-icon">
                    ⓘ
                  </span>

                </summary>

                <div class="challenge-shooting-setting-description">

                  ➤F値はレンズの絞りの大きさを表す値です。
                  数値が小さいほど背景をぼかしやすくなります。

                </div>

              </details>

            </div>


            <!-- ISO -->

            <div class="challenge-shooting-setting-item">

              <details class="challenge-shooting-setting-details">

                <summary class="challenge-shooting-setting-header">

                  <%= sf.label :iso, "ISO" %>

                  <%= sf.number_field :iso,
                      placeholder: "例：100" %>

                  <span class="challenge-info-icon">
                    ⓘ
                  </span>

                </summary>

                <div class="challenge-shooting-setting-description">

                  ➤ISO感度は、カメラが光を受け取る感度を表します。
                  数値を上げると暗い場所でも明るく撮影できますが、
                  ノイズが増えやすくなります。

                </div>

              </details>

            </div>


            <!-- シャッタースピード -->

            <div class="challenge-shooting-setting-item">

              <details class="challenge-shooting-setting-details">

                <summary class="challenge-shooting-setting-header">

                  <%= sf.label :shutter_speed, "シャッタースピード" %>

                  <%= sf.text_field :shutter_speed,
                      placeholder: "例：1/250" %>

                  <span class="challenge-info-icon">
                    ⓘ
                  </span>

                </summary>

                <div class="challenge-shooting-setting-description">

                  ➤シャッターが開いている時間を表します。
                  速くすると動きを止めやすく、
                  遅くすると動きのブレや光の軌跡を表現できます。

                </div>

              </details>

            </div>


            <!-- 焦点距離 -->

            <div class="challenge-shooting-setting-item">

              <details class="challenge-shooting-setting-details">

                <summary class="challenge-shooting-setting-header">

                  <%= sf.label :focal_length, "焦点距離" %>

                  <%= sf.text_field :focal_length,
                      placeholder: "例：50mm" %>

                  <span class="challenge-info-icon">
                    ⓘ
                  </span>

                </summary>

                <div class="challenge-shooting-setting-description">

                  ➤レンズの焦点距離を表す値です。
                  数値が小さいほど広い範囲を写し、
                  数値が大きいほど遠くの被写体を大きく写せます。

                </div>

              </details>

            </div>

          <% end %>

        </div>


        <!-- 撮影技法・構図 -->

        <div class="challenge-edit-card challenge-edit-blue-card">

          <h2>
            撮影技法・構図
            <span class="challenge-edit-optional">
              （複数選択可）
            </span>
          </h2>

          <div class="challenge-technique-list">

            <% @techniques.each do |technique| %>

              <div class="challenge-technique-item">

                <%= check_box_tag "challenge[technique_ids][]",
                    technique.id,
                    @challenge.technique_ids.include?(technique.id),
                    id: "challenge_technique_#{technique.id}" %>

                <div class="technique-content">

                  <details class="challenge-technique-details">

                    <summary>

                      <%= label_tag "challenge_technique_#{technique.id}",
                          technique.name %>

                      <span class="challenge-info-icon">
                        ⓘ
                      </span>

                    </summary>

                    <div class="challenge-technique-description">
                      <%= technique.description %>
                    </div>  

                  </details>
                </div>
              </div>

            <% end %>

          </div>

        </div>

      </div>

    </div>


    <!-- =========================
         下部ボタン
         ========================= -->

    <div class="challenge-edit-actions">

      <%= link_to "キャンセル",
          photo_challenge_path(@photo, @challenge),
          class: "challenge-cancel-button" %>

      <%= f.submit "更新する",
          class: "challenge-update-button" %>

    </div>

  <% end %>

</div>