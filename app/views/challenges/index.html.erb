<h1>チャレンジ一覧</h1>

<% if @challenges.any? %>
  <div class="challenge-list">

    <% @challenges.each do |challenge| %>

      <div class="challenge-card">

        <h2>撮影チャレンジ</h2>

        <div class="challenge-photo-comparison">

          <!-- 参考写真 -->
          <div class="challenge-photo-card">

            <h3>📷 参考写真</h3>

            <% if challenge.reference_photo.image.attached? %>
              <div class="photo-zoom-container">
                <%= image_tag challenge.reference_photo.image,
                    class: "challenge-photo challenge-zoom-trigger" %>
              </div>
            <% end %>

            <p class="challenge-title">
              <%= link_to challenge.reference_photo.title,
                  photo_path(challenge.reference_photo) %>
            </p>

          </div>


          <!-- 矢印 -->
          <div class="challenge-arrow">
            ➡
          </div>


          <!-- チャレンジ写真 -->
          <div class="challenge-photo-card">

            <h3>🔥 チャレンジ写真</h3>

            <% if challenge.image.attached? %>
              <div class="photo-zoom-container">
                <%= image_tag challenge.image,
                    class: "challenge-photo challenge-zoom-trigger" %>
              </div>
            <% end %>

            <p class="challenge-title">
              <%= challenge.title %>
            </p>

          </div>

        </div>


        <!-- 撮影技法・構図 -->
        <div class="challenge-techniques">

          <h4>撮影技法・構図</h4>

          <% techniques = (
            challenge.reference_photo.techniques +
            challenge.techniques
          ).map(&:name).uniq %>

          <% if techniques.any? %>

            <div class="challenge-technique-tags">

              <% techniques.each do |technique_name| %>
                <span class="technique-tag">
                  <%= technique_name %>
                </span>
              <% end %>

            </div>

          <% else %>

            <p>登録されていません</p>

          <% end %>

        </div>


        <!-- チャレンジ情報・詳細ボタン -->
        <div class="challenge-card-footer">

          <div class="challenge-meta">

            <span class="challenge-user">
              👤 <%= challenge.user.username %>
            </span>

            <span class="challenge-stats">

              <%= render "favorite", challenge: challenge %>

              <span class="challenge-comment-count">
                💬 <%= challenge.challenge_comments.count %>
              </span>

            </span>

          </div>

          <%= link_to "詳細を見る", 
              edit_photo_challenge_path(
                challenge.reference_photo,
                challenge
              ),
              class: "challenge-detail-button" %>

        </div>

      </div>

    <% end %>

  </div>

<% else %>

  <p>まだ撮影チャレンジがありません。</p>

<% end %>


<!-- 写真拡大モーダル -->
<div id="challenge-zoom-modal" class="photo-zoom-modal">

  <button
    id="challenge-zoom-close"
    class="photo-zoom-close">
    ×
  </button>

  <img
    id="challenge-zoom-image"
    class="photo-zoom-image"
    src=""
    alt="拡大写真"
  >

</div>


<%= link_to "ホームに戻る", home_path %>