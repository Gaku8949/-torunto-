<div class="challenge-page">

  <%= link_to "← チャレンジ一覧に戻る",
      challenges_path,
      class: "back-link" %>

  <h1>撮影チャレンジ</h1>

  <%= form_with model: [@photo, @challenge], class: "challenge-form" do |f| %>

    <div class="challenge-grid">

      <!-- =================================
           左側：参考
           ================================= -->
      <div class="challenge-reference">

        <div class="challenge-card">

          <h2>
            参考写真
            <span class="reference-hint">
              お手本の写真を見て挑戦してみよう！
            </span>
          </h2>

          <% if @photo.image.attached? %>
            <%= image_tag @photo.image,
                class: "reference-image" %>
          <% end %>

          <h3><%= @photo.title %></h3>


          <!-- 参考の撮影設定 -->

          <div class="reference-setting">

            <h2>参考の撮影設定</h2>

            <% if @photo.shooting_setting.present? %>

              <div class="reference-setting-row">
                <span>F値</span>
                <span class="reference-setting-value">
                  <%= @photo.shooting_setting.aperture %>
                </span>
              </div>

              <div class="reference-setting-row">
                <span>ISO</span>
                <span class="reference-setting-value">
                  <%= @photo.shooting_setting.iso %>
                </span>
              </div>

              <div class="reference-setting-row">
                <span>シャッタースピード</span>
                <span class="reference-setting-value">
                  <%= @photo.shooting_setting.shutter_speed %>
                </span>
              </div>

              <div class="reference-setting-row">
                <span>焦点距離</span>
                <span class="reference-setting-value">
                  <%= @photo.shooting_setting.focal_length %>
                </span>
              </div>

            <% end %>

          </div>


          <!-- 参考の撮影技法・構図 -->

          <div class="reference-technique">

            <h3>参考の撮影技法・構図</h3>

            <div class="reference-technique-tags">

              <% @photo.techniques.each do |technique| %>

                <span class="reference-technique-tag">
                  <%= technique.name %>
                </span>

              <% end %>

            </div>

          </div>

        </div>

      </div>


      <!-- =================================
           右側：チャレンジ
           ================================= -->
      <div class="challenge-target">

        <div class="challenge-card">

          <h2>チャレンジ写真</h2>

          <!-- 写真アップロード -->
          <div class="challenge-upload">

            <div class="image-upload-icon">▧</div>

            <strong>写真を選択</strong>

            <p>
              クリック、またはドラッグ＆ドロップで画像を選択
            </p>

            <span>
              対応形式：jpg / jpeg / png（最大10MB）
            </span>

            <%= f.file_field :image,
                accept: "image/*",
                class: "image-file-input" %>

          </div>


          <!-- タイトル -->
          <div class="challenge-form-section challenge-title-section">

            <%= f.label :title, "タイトル" %>

            <%= f.text_field :title,
                placeholder: "タイトルを入力してください",
                class: "form-input" %>

          </div>

        
          <!-- 撮影場所 -->
          <div class="challenge-new-card challenge-new-blue-card">

            <div class="challenge-form-section">

              <%= f.label :location, "撮影場所" %>

              <%= f.text_field :location,
                  placeholder: "撮影場所を入力してください",
                  class: "form-input" %>

            </div>

          </div>

        <!-- =================================
             今回の撮影設定
             ================================= -->
          
          <div class="challenge-new-card challenge-new-blue-card">

            <h3>今回の撮影設定 <span class="optional">（任意）</span></h3>

            <%= f.fields_for :shooting_setting do |sf| %>
              <div class="challenge-setting">
              
                <details class="challenge-setting-details">

                  <summary class="challenge-setting-row">
                    <%= sf.label :aperture, "F値" %>
                    <%= sf.number_field :aperture, placeholder: "例：5.6" %>
                    <span class="info-icon">ⓘ</span>
                  </summary>

                  <div class="shooting-setting-description">
                    ➤F値はレンズの絞りの大きさを表す値です。
                    数値が小さいほど背景をぼかしやすくなります。
                  </div>
                </details>
              </div>

              <div class="challenge-setting">

                <details class="challenge-setting-details">

                  <summary class="challenge-setting-row">
                    <%= sf.label :iso, "ISO" %>
                    <%= sf.number_field :iso, placeholder: "例：100" %>
                      <span class="info-icon">ⓘ</span>
                  </summary>

                  <div class="shooting-setting-description">
                    ➤ISO感度は、カメラが光を受け取る感度を表します。
                    数値を上げると暗い場所でも明るく撮影できますが、ノイズが増えやすくなります。
                  </div>
                </details>
              </div>

              <div class="challenge-setting">
              
                <details class="challenge-setting-details">

                  <summary class="challenge-setting-row">
                    <%= sf.label :shutter_speed, "シャッタースピード" %>
                    <%= sf.text_field :shutter_speed, placeholder: "例：1/250" %>
                      <span class="info-icon">ⓘ</span>
                  </summary>

                  <div class="shooting-setting-description">
                    ➤シャッターが開いている時間を表します。
                    速くすると動きを止めやすく、遅くすると動きのブレや光の軌跡を表現できます。
                  </div> 

                </details>
              </div>

              <div class="challenge-setting">
              
                <details class="challenge-setting-details">

                  <summary class="challenge-setting-row">
                    <%= sf.label :focal_length, "焦点距離" %>
                    <%= sf.text_field :focal_length, placeholder: "例：50mm" %>
                      <span class="info-icon">ⓘ</span>
                  </summary>
                
                  <div class="shooting-setting-description">
                    ➤レンズの焦点距離を表す値です。
                    数値が小さいほど広い範囲を写し、数値が大きいほど遠くの被写体を大きく写せます。
                  </div>

                </details>
              </div>

            <% end %>

          </div>

          <!-- 意識した撮影技法 -->
          <div class="challenge-new-card challenge-new-blue-card">

            <div class="challenge-technique-section">

              <h3>
                意識した撮影技法・構図
                <span class="optional">（複数選択可）</span>
              </h3>

              <div class="challenge-technique-grid">

                <% @techniques.each do |technique| %>

                  <div class="challenge-technique-item">

                    <%= check_box_tag "challenge[technique_ids][]",
                        technique.id,
                        false,
                        id: "challenge_technique_#{technique.id}" %>

                    <details class="technique-details">

                      <summary>
                        <%= technique.name %>
                        <span class="info-icon">ⓘ</span>
                      </summary>

                      <div class="technique-description">
                        <%= technique.description %>
                      </div>

                    </details>

                  </div>

                <% end %>

              </div>

            </div>
          
          </div>

        </div>

      </div>

    </div>


    <!-- =================================
         コメント
         ================================= -->
    <div class="challenge-comment">

      <%= f.label :comment, "コメント" %>

      <%= f.text_area :comment,
          placeholder: "参考写真を意識して工夫したポイントなどを入力してください",
          class: "form-textarea" %>

    </div>


    <!-- =================================
         下部ボタン
         ================================= -->
    <div class="challenge-actions">

      <%= link_to "キャンセル",
          photos_path,
          class: "cancel-button" %>

      <%= f.submit "チャレンジを投稿する",
          class: "submit-button" %>

    </div>

  <% end %>
